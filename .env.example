# ─────────────────────────────────────────────────────────────────────────
# SIMOVI simulator — port & host configuration
#
# Every port the simulator stack exposes or connects to lives here. Copy this
# file to `.env` and adjust to match your databus deployment:
#
#     cp .env.example .env
#     docker compose up --build
#
# All values have sensible defaults baked into docker-compose.yml, so a missing
# .env still works for the standard layout. Override only what differs.
# ─────────────────────────────────────────────────────────────────────────

# ── Ports the simulator stack PUBLISHES on the host ──────────────────────
WEB_PORT=8080          # Browser UI (nginx)
SIM_HTTP_PORT=8081     # Simulator FastAPI control API
MQTT_WS_PORT=8083      # MQTT-over-WebSockets, consumed by the browser UI
MQTT_TCP_PORT=1884     # Bridge plain-MQTT listener (simulator → bridge, in-network)

# ── The databus stack the simulator CONNECTS TO ──────────────────────────
# host.docker.internal reaches services on the host (Docker Desktop, or Linux
# via the host-gateway mapping in docker-compose.yml). Point these at a
# different hostname/IP if databus runs elsewhere.
DATABUS_HOST=host.docker.internal
DATABUS_HTTP_PORT=8000          # Orchestrator REST API (create/update run)
DATABUS_MQTT_HOST=host.docker.internal
DATABUS_MQTT_PORT=1883          # Telemetry broker (MQTT)

# ── Redis (run-lifecycle state) ──────────────────────────────────────────
# Defaults to the redis bundled in docker-compose.yml. Point at databus's redis
# if you want to share run state: redis://host.docker.internal:6379/0
REDIS_URL=redis://redis:6379/0
