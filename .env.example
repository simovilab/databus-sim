# ─────────────────────────────────────────────────────────────────────────
# SIMOVI simulator — configuration
#
# Copy this file to `.env` and override only what differs from the defaults:
#
#     cp .env.example .env
#     docker compose up --build          # Docker reads .env automatically
#     ./scripts/dev.sh                    # local run; also reads .env
#
# Every value has a default baked into the code/compose, so a missing .env
# still works for the standard layout. `.env` is git-ignored.
#
# Both run paths honor this file:
#   • docker compose substitutes ${VAR} below into docker-compose.yml.
#   • local runs: sim_project/settings.py loads .env via python-dotenv, and
#     scripts/dev.sh binds uvicorn to $WEB_PORT.
# ─────────────────────────────────────────────────────────────────────────

# ── The one port the simulator serves on (UI + REST API + WebSocket) ──────
# Change this to move the whole service. In Docker it is published as
# WEB_PORT:WEB_PORT; locally, scripts/dev.sh binds uvicorn to it.
WEB_PORT=8080

# ── The databus stack the simulator CONNECTS TO ───────────────────────────
# host.docker.internal reaches services on the host (Docker Desktop, or Linux
# via the host-gateway mapping in docker-compose.yml). Point these at a
# different hostname/IP if databus runs elsewhere. For a LOCAL (non-Docker)
# run against a local databus, use 127.0.0.1 instead of host.docker.internal.
DATABUS_HOST=host.docker.internal
DATABUS_HTTP_PORT=8000           # Orchestrator REST API (create/update/read run, trips)
DATABUS_MQTT_HOST=host.docker.internal
DATABUS_MQTT_PORT=1883           # Telemetry broker (MQTT) the sim publishes to

# ── Telemetry topic root (must match what databus's consumer subscribes to) ─
MQTT_TOPIC_ROOT=transit/vehicle

# ── Simulator timing knobs (seconds) ──────────────────────────────────────
SIM_TICK_INTERVAL=2.0            # Vehicle kinematics + telemetry tick
POST_RUN_IDLE_S=30               # Keep transmitting this long after the terminal stop
RUN_POLL_INTERVAL_S=2.0          # How often the run-binder polls databus run state
SCHEDULER_TICK_S=1.0             # Schedule.yaml dispatch tick

# ── Django ────────────────────────────────────────────────────────────────
DEBUG=true
# LOG_LEVEL=INFO
# DJANGO_SECRET_KEY=change-me      # only matters if you enable sessions/CSRF
# ALLOWED_HOSTS=*

# ── NavSat map overlay (optional) ──────────────────────────────────────────
# Real-world vehicle positions shown on the map alongside the simulated fleet,
# selectable via the "NavSat buses" map control. NAVSAT_URL embeds a vendor API
# token — treat it as a secret, never commit a real value. Leave unset to
# disable the feature entirely (no vendor account needed to run the sim).
# NAVSAT_URL=
# NAVSAT_POLL_INTERVAL_S=10

# ── Advanced / rarely changed ──────────────────────────────────────────────
# For a fully LOCAL run (not Docker), settings default MQTT_HOST=localhost and
# DATABUS_BASE_URL=http://localhost:8000. docker-compose.yml derives these from
# the DATABUS_* vars above, so you normally don't set them by hand.
# MQTT_HOST=localhost
# MQTT_PORT=1883
# DATABUS_BASE_URL=http://localhost:8000
# SIM_ONLY_VEHICLES=unit-01,unit-02
# SIM_STOP_VEHICLES=unit-06
# SIM_RANDOM_DROP_RATE=0
# SIM_STOP_ALL_AFTER=0
