{
  "context": {
    "feed_type": null,
    "storage_format": null,
    "blob_size_bytes": 0,
    "snapshot_timestamp": null
  },
  "id": "save-gtfs-feed-messages",
  "initial": "waiting",
  "states": {
    "waiting": {
      "on": {
        "tasks.SAVE_TRIGGERED": [
          {
            "target": "serializing",
            "actions": [
              {
                "type": "tasks.receive_feed_data"
              }
            ]
          }
        ]
      }
    },
    "serializing": {
      "entry": [
        {
          "type": "tasks.convert_to_parquet"
        },
        {
          "type": "tasks.enrich_metadata"
        },
        {
          "type": "tasks.calculate_blob_size"
        }
      ],
      "on": {
        "tasks.SERIALIZATION_SUCCEEDED": [
          {
            "target": "persisting",
            "actions": []
          }
        ],
        "tasks.SERIALIZATION_FAILED": [
          {
            "target": "notifying",
            "actions": []
          }
        ]
      }
    },
    "persisting": {
      "entry": {
        "type": "tasks.persist_parquet_file"
      },
      "on": {
        "tasks.PERSIST_SUCCEEDED": [
          {
            "target": "waiting",
            "actions": [
              {
                "type": "tasks.emit_persistence_assertion"
              },
              {
                "type": "tasks.clear_feed_data"
              }
            ]
          }
        ],
        "tasks.PERSIST_FAILED": [
          {
            "target": "notifying",
            "actions": []
          }
        ]
      }
    },
    "notifying": {
      "entry": [
        {
          "type": "tasks.send_notifications"
        },
        {
          "type": "tasks.flush_data"
        },
        {
          "type": "tasks.log_errors"
        }
      ],
      "on": {
        "tasks.SAVE_NOTIFICATION_SENT": [
          {
            "target": "waiting",
            "actions": []
          }
        ]
      }
    }
  }
}